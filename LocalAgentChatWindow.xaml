<Window x:Class="RagdollPet.LocalAgentChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="团团的小窝" Width="390" Height="535" MinWidth="350" MinHeight="460"
        WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#51413F" FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="#70514B"/>
            <Setter Property="Background" Value="#FFFFF9F4"/>
            <Setter Property="BorderBrush" Value="#FFE8D2C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="12" CornerRadius="25" BorderBrush="#E8CFC6" BorderThickness="1"
            Background="#FFFFF8F2" Padding="16">
        <Border.Effect>
            <DropShadowEffect Color="#775C55" BlurRadius="22" ShadowDepth="5" Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="1,0,0,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="21" Background="#FFF2D9D2" VerticalAlignment="Center">
                    <TextBlock Text="🐾" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="团团的小窝" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="想说什么悄悄告诉我～" FontSize="11" Foreground="#A18179" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="×" ToolTip="收起聊天框" Style="{StaticResource PillButton}"
                        Padding="9,4" Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Click="ClosePopup_Click"/>
            </Grid>

            <Border Grid.Row="1" CornerRadius="14" Background="#FFFFFDF9" BorderBrush="#F2E3D9"
                    BorderThickness="1" Padding="10,7" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="陪伴模型" Foreground="#9B7770" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ModelSelector" Grid.Column="1" IsEditable="False" IsTextSearchEnabled="True"
                              BorderThickness="0" Background="Transparent" Padding="4,3"
                              ToolTip="选择 Ollama 中已安装的本地模型" SelectionChanged="ModelSelector_SelectionChanged"/>
                    <TextBlock x:Name="StatusText" Grid.Row="1" Text="正在连接本地模型…" Foreground="#9B7770"
                               FontSize="10" VerticalAlignment="Center" Margin="0,4,6,0"/>
                    <Button x:Name="ReconnectButton" Grid.Row="1" Grid.Column="2" Content="重试 ↻"
                            ToolTip="重试连接本地模型" Style="{StaticResource PillButton}" Padding="8,3"
                            FontSize="10" Margin="0,3,0,0" Click="Reconnect_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#FFFFFEFC" BorderBrush="#F0DFD6" BorderThickness="1"
                    CornerRadius="18" Padding="10">
                <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HistoryPanel"/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,10,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="#EBD7CF" BorderThickness="1" CornerRadius="15" Padding="3">
                    <TextBox x:Name="InputBox" MinHeight="38" MaxHeight="90" Padding="9,7" BorderThickness="0"
                             Background="Transparent" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" KeyDown="InputBox_KeyDown"
                             ToolTip="Enter 发送，Shift+Enter 换行"/>
                </Border>
                <Button x:Name="SendButton" Grid.Column="1" Content="发送 ➊" MinWidth="78" Margin="8,0,0,0"
                        Background="#FFEAC2B5" BorderBrush="#FFEAC2B5" Foreground="#69443E"
                        FontWeight="SemiBold" Style="{StaticResource PillButton}" Click="Send_Click"/>
            </Grid>
            <TextBlock Grid.Row="4" Text="🔒 只连接本机。文件或命令操作会先征求你的同意。"
                       FontSize="10" Foreground="#A58F87" TextWrapping="Wrap" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
