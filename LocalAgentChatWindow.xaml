<Window x:Class="RagdollPet.LocalAgentChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="团团的小窝" Width="390" Height="535" MinWidth="350" MinHeight="460"
        WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#51413F" FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="#70514B"/>
            <Setter Property="Background" Value="#FFFFF9F4"/>
            <Setter Property="BorderBrush" Value="#FFE8D2C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="12" CornerRadius="25" BorderBrush="#E8CFC6" BorderThickness="1"
            Background="#FFFFF8F2" Padding="16">
        <Border.Effect>
            <DropShadowEffect Color="#775C55" BlurRadius="22" ShadowDepth="5" Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ConversationSidebar" Grid.Column="0" Visibility="Collapsed"
                    Background="#FFF5EAE3" CornerRadius="18" Margin="0,0,10,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="1,2,1,13">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🐾" FontSize="21" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="团团的聊天" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="本地保存 · 仅此设备" FontSize="10" Foreground="#A18179"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="＋" ToolTip="新建聊天" Style="{StaticResource PillButton}"
                                Padding="9,5" Click="NewConversation_Click"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#FFFFFCF8" BorderBrush="#EAD8CE" BorderThickness="1"
                            CornerRadius="11" Padding="8,4" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock Text="⌕" FontSize="16" Foreground="#A18179" Margin="0,0,6,0"/>
                            <TextBox x:Name="ConversationSearchBox" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" ToolTip="搜索本地聊天记录" TextChanged="ConversationSearch_TextChanged"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Grid.Row="2" Text="最近的聊天" FontSize="11" Foreground="#9B7770" Margin="4,2,0,5"/>
                    <ListBox x:Name="ConversationList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                             SelectionChanged="ConversationList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding UpdatedLabel}" FontSize="10" Foreground="#A58F87" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="4" Content="删除当前聊天" Style="{StaticResource PillButton}"
                            HorizontalAlignment="Stretch" Foreground="#9C6258" Margin="0,9,0,0" Click="DeleteConversation_Click"/>
                </Grid>
            </Border>
            <Grid x:Name="ChatPane" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="1,0,0,11" MouseLeftButtonDown="Header_DragMove">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="21" Background="#FFF2D9D2" VerticalAlignment="Center">
                    <TextBlock Text="🐾" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="团团的小窝" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="想说什么悄悄告诉我～" FontSize="11" Foreground="#A18179" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="FullInterfaceButton" Grid.Column="2" Content="⤢" ToolTip="打开完整聊天界面" Style="{StaticResource PillButton}"
                        Padding="9,5" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="FullInterface_Click"/>
                <Button x:Name="CompactButton" Grid.Column="2" Content="↙" ToolTip="收回桌面浮窗" Style="{StaticResource PillButton}"
                        Padding="9,5" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" Click="Compact_Click"/>
                <Button x:Name="MinimizeButton" Grid.Column="3" Content="—" ToolTip="最小化" Style="{StaticResource PillButton}"
                        Padding="9,4" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" Click="Minimize_Click"/>
                <Button x:Name="MaximizeButton" Grid.Column="4" Content="□" ToolTip="最大化 / 还原" Style="{StaticResource PillButton}"
                        Padding="9,4" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" Click="Maximize_Click"/>
                <Button Grid.Column="5" Content="×" ToolTip="收起聊天框" Style="{StaticResource PillButton}"
                        Padding="9,4" Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Click="ClosePopup_Click"/>
            </Grid>

            <Border Grid.Row="1" CornerRadius="14" Background="#FFFFFDF9" BorderBrush="#F2E3D9"
                    BorderThickness="1" Padding="10,7" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="陪伴模型" Foreground="#9B7770" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ModelSelector" Grid.Column="1" IsEditable="False" IsTextSearchEnabled="True"
                              BorderThickness="0" Background="Transparent" Padding="4,3"
                              ToolTip="选择 Ollama 中已安装的本地模型" SelectionChanged="ModelSelector_SelectionChanged"/>
                    <TextBlock x:Name="StatusText" Grid.Row="1" Text="正在连接本地模型…" Foreground="#9B7770"
                               FontSize="10" VerticalAlignment="Center" Margin="0,4,6,0"/>
                    <Button x:Name="ReconnectButton" Grid.Row="1" Grid.Column="2" Content="重试 ↻"
                            ToolTip="重试连接本地模型" Style="{StaticResource PillButton}" Padding="8,3"
                            FontSize="10" Margin="0,3,0,0" Click="Reconnect_Click"/>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,5,0,0">
                        <CheckBox x:Name="FileSkillsToggle" Content="文件搜索" IsChecked="True"
                                  ToolTip="启用目录浏览、文本读取及目录内搜索；只访问你指定的目录"
                                  VerticalAlignment="Center" FontSize="10" Foreground="#805E56"
                                  Margin="1,0,16,0" Checked="SkillToggle_Changed" Unchecked="SkillToggle_Changed"/>
                        <CheckBox x:Name="PdfSkillToggle" Content="PDF 读取与摘要" IsChecked="True"
                                  ToolTip="启用本地 PDF 文本提取与总结；扫描件 OCR 暂不支持"
                                  VerticalAlignment="Center" FontSize="10" Foreground="#805E56"
                                  Checked="SkillToggle_Changed" Unchecked="SkillToggle_Changed" Margin="0,0,14,0"/>
                        <CheckBox x:Name="WebSearchSkillToggle" Content="网页搜索" IsChecked="False"
                                  ToolTip="开启后，信息问题、解释和推荐会自动联网搜索；只发送当前问题，不发送聊天历史或本地文件"
                                  VerticalAlignment="Center" FontSize="10" Foreground="#805E56"
                                  Checked="SkillToggle_Changed" Unchecked="SkillToggle_Changed"/>
                        <Button x:Name="WebSearchKeyButton" Content="设置" ToolTip="选择 SearXNG、专用 Chrome 或 Ollama 搜索方式"
                                Style="{StaticResource PillButton}" Padding="6,1" Margin="7,0,0,0"
                                FontSize="10" VerticalAlignment="Center" Click="WebSearchKey_Click"/>
                        <TextBlock x:Name="WebSearchModeText" Text="网页搜索：本地 SearXNG"
                                   FontSize="10" Foreground="#9B7770" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#FFFFFEFC" BorderBrush="#F0DFD6" BorderThickness="1"
                    CornerRadius="18" Padding="10">
                <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HistoryPanel"/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,10,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="#EBD7CF" BorderThickness="1" CornerRadius="15" Padding="3">
                    <TextBox x:Name="InputBox" MinHeight="38" MaxHeight="90" Padding="9,7" BorderThickness="0"
                             Background="Transparent" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" KeyDown="InputBox_KeyDown"
                             ToolTip="Enter 发送，Shift+Enter 换行"/>
                </Border>
                <Button x:Name="SendButton" Grid.Column="1" Content="发送 ➊" MinWidth="78" Margin="8,0,0,0"
                        Background="#FFEAC2B5" BorderBrush="#FFEAC2B5" Foreground="#69443E"
                        FontWeight="SemiBold" Style="{StaticResource PillButton}" Click="Send_Click"/>
                <Button x:Name="CancelSearchButton" Grid.Column="2" Content="取消搜索" MinWidth="72" Margin="7,0,0,0"
                        Style="{StaticResource PillButton}" Visibility="Collapsed" Click="CancelSearch_Click"/>
            </Grid>
            <TextBlock Grid.Row="4" Text="🔒 模型连接本机；网页搜索只发送当前搜索词给所选服务。文件或命令操作会先征求同意。"
                       FontSize="10" Foreground="#A58F87" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
